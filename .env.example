# Clotilde Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is already in .gitignore and will not be committed

# Primary model provider: Claude Haiku direct API (recommended for CarPlay)
# Get from: https://console.anthropic.com/settings/keys
CLAUDE_KEY_SECRET_NAME=sk-ant-YOUR_CLAUDE_API_KEY_HERE

# Optional model provider: OpenRouter
# Use this when you want one key for OpenRouter-hosted models like
# openrouter/anthropic/claude-haiku-4.5
# OPENROUTER_KEY_SECRET_NAME=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# Optional fallback provider: OpenAI Responses API
# The OpenAI API uses bearer API keys for server-to-server calls.
# OPENAI_KEY_SECRET_NAME=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Clotilde Service API Key (for authenticating requests)
# Generate with: openssl rand -hex 32
API_KEY_SECRET_NAME=YOUR_CLOTILDE_API_KEY_HERE

# Google Cloud Project ID (for local development with Secret Manager)
GOOGLE_CLOUD_PROJECT=your-project-id

# Service URL (after deployment)
# This will be set automatically by Cloud Run
# For local testing, you can set it to your deployed service URL
SERVICE_URL=https://your-service-url.run.app

# Logging privacy
# Leave false/empty for metadata-only logs. Set true only for intentional debugging.
LOG_FULL_CONTENT=false

# Optional OpenRouter attribution headers
OPENROUTER_APP_TITLE=Clotilde CarPlay Assistant
# OPENROUTER_SITE_URL=https://your-service-url.run.app
