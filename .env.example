# Clotilde Environment Variables
# Copy to .env for local runs. The .env is gitignored.

# Service API key (X-API-Key) — direct value for local dev, or Secret Manager name for prod
API_KEY_SECRET_NAME=YOUR_SERVICE_API_KEY

# Hermes gateway bearer key — direct value for local dev, or Secret Manager name for prod
HERMES_KEY_SECRET_NAME=YOUR_HERMES_BEARER_KEY

# Google Cloud project (Secret Manager lookups + Cloud Logging)
GOOGLE_CLOUD_PROJECT=sorteador-versiculos

# Hermes gateway endpoint (authenticated TLS front door of the gateway;
# intentionally not committed to this public repo)
HERMES_CHAT_URL=https://<your-gateway-host>/v1/chat/completions

# Logging privacy: metadata-only by default
LOG_FULL_CONTENT=false
LOG_REDACT_PII=true

# Optional: CORS origin for browser-based testing tools
# CORS_ALLOWED_ORIGIN=https://your-tool.example

# Optional: bearer token for /metrics (unset = endpoint 404s)
# METRICS_TOKEN=long-random-string
